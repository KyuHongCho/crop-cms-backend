.env
.venv/
dockerenv/
__pycache__/
*.pyc
.DS_Store

# JetBrains IDE state (PyCharm/IntelliJ). Per-user, not per-project:
# workspace.xml records absolute paths and uncommitted-change state.
.idea/

# Terraform: local plugin cache, state and saved plans (may hold secrets) and per-person variables.
# .terraform.lock.hcl and terraform.tfvars.example stay tracked.
.terraform/
*.tfstate*
*.tfvars
*.tfvars.json
tfplan
*.tfplan
