# Copy to .env (git- and docker-ignored) and fill in. Never commit .env.
# Two setups share this file: development (docker-compose.yaml) and production
# (docker-compose.prod.yaml). The blocks below say which each variable is for.

# ---- Development ----

# Required: docker-compose.yaml refuses to start without these.
POSTGRES_PASSWORD=
DB_USER=cms_app
# Hex or alphanumeric only (`openssl rand -hex 24`). The database URL takes it unescaped: an @
# misparses it and a %41-style escape is silently decoded (app/db/db.py, migrate_db.py). In this
# file a $name or a space before # truncates the value (a $ gives only a compose warning).
DB_PASSWORD=

# Optional: only the AI features need it, and the test suite does not.
# OPENAI_API_KEY is needed by scripts/reindex.py and by POST /chat (query
# embedding, text-embedding-3-small); /chat answers 503 without it.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY is needed by POST /chat (the classifier and generator calls).
ANTHROPIC_API_KEY=
# Optional: the models POST /chat uses (unset or empty: the default in
# app/chat/llm.py, claude-haiku-5-5 for both).
# CHAT_MODEL_CLASSIFY=claude-haiku-5-5
# CHAT_MODEL_GENERATE=claude-haiku-5-5

# Needed to log in (signs the JWT): `openssl rand -hex 32`. Tokens last
# 30 minutes (ACCESS_TOKEN_EXPIRE_MINUTES); there is no refresh-token flow.
SECRET_KEY=

# Optional: starting daily token budget for new members (default 20000).
# TOKENS_BUDGET_DAILY=20000

# Optional: login throttling. At most LOGIN_MAX_FAILURES counted attempts per account in each
# LOGIN_WINDOW_SECONDS window (defaults 10 and 900); both must be integers >= 1 or the app will not start
# (LOGIN_WINDOW_SECONDS <= 315360000).
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_SECONDS=900

# Optional, development: SQL_ECHO=1 logs every SQL statement with its parameters. The dev
# compose file sets it; the app's own default is off, and the production file never sets it.
# SQL_ECHO=1

# ---- Production (docker-compose.prod.yaml, run on the server) ----
# Set the same names as above, with these differences: there is no db service, so
# POSTGRES_PASSWORD is not used; DB_HOST (the database server's address), DB_USER, DB_PASSWORD
# and SECRET_KEY are required; DB_NAME is fixed to cms; OPENAI_API_KEY and ANTHROPIC_API_KEY
# are set as above.
# DB_HOST=
# The public domain Caddy obtains a certificate for. Required, with no plain-HTTP default.
# SITE_ADDRESS=
# Directory with the built frontend, served at / (default /opt/cms/site).
# SITE_DIR=/opt/cms/site
# TLS mode for the database connection, fixed to `require` in the compose file. It encrypts
# but does not check the server certificate.
# PGSSLMODE=require
