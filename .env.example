# Copy to .env (git- and docker-ignored) and fill in. Never commit .env.

# Required: docker-compose.yaml refuses to start without these.
POSTGRES_PASSWORD=
DB_USER=cms_app
DB_PASSWORD=

# Optional: only the AI features need them, and the test suite needs neither.
# OPENAI_API_KEY is read by scripts/reindex.py (text-embedding-3-small).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
