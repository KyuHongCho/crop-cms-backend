# Copy to .env (git- and docker-ignored) and fill in. Never commit .env.

# Required: docker-compose.yaml refuses to start without these.
POSTGRES_PASSWORD=
DB_USER=cms_app
DB_PASSWORD=

# Optional: only the AI features need it, and the test suite does not.
# OPENAI_API_KEY is needed by scripts/reindex.py and by POST /chat (query
# embedding, text-embedding-3-small); /chat answers 503 without it.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY is needed by POST /chat (the classifier and generator calls).
ANTHROPIC_API_KEY=
# Optional: the models POST /chat uses (unset or empty: the default in
# app/chat/llm.py, claude-haiku-4-5 for both).
# CHAT_MODEL_CLASSIFY=claude-haiku-4-5
# CHAT_MODEL_GENERATE=claude-haiku-4-5

# Needed to log in (signs the JWT): `openssl rand -hex 32`. Tokens last
# 30 minutes (ACCESS_TOKEN_EXPIRE_MINUTES); there is no refresh-token flow.
SECRET_KEY=

# Optional: starting daily token budget for new members (default 20000).
# TOKENS_BUDGET_DAILY=20000

# Optional: login throttling. At most LOGIN_MAX_FAILURES counted attempts per account in each
# LOGIN_WINDOW_SECONDS window (defaults 10 and 900); both must be integers >= 1 or the app will not start
# (LOGIN_WINDOW_SECONDS <= 315360000).
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_SECONDS=900
