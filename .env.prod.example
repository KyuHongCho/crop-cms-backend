# Copy to /opt/cms/.env (outside the clone), fill in the blanks, and pass it to every compose
# command with --env-file /opt/cms/.env; compose does not find it alone. Unfilled, it won't start.
# Put no comment after a value: a space and # ends the value there.
COMPOSE_PROJECT_NAME=cms

# The database server's address: `terraform output -raw db_endpoint` in infra/.
DB_HOST=
DB_USER=cms_app
# Hex or alphanumeric only (`openssl rand -hex 24`). The database URL takes it unescaped: an @
# misparses it and a %41-style escape is silently decoded.
DB_PASSWORD=
# Signs the login JWT: `openssl rand -hex 32`.
SECRET_KEY=

# Only the AI features need these: the first for reindexing and POST /chat, the second for
# POST /chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The public domain Caddy gets a certificate for. Required, with no plain-HTTP default.
SITE_ADDRESS=
# The certificate authority: Let's Encrypt production. For testing, use the staging address
# below instead. Keep one ACME_CA line active: compose takes the last one.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Starting daily token budget per new member; the compose default is 20000.
TOKENS_BUDGET_DAILY=100000
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_SECONDS=900

# SITE_DIR=/opt/cms/site
